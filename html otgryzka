function mountWeekdays(st){drawBar(document.getElementById('cwdbarc'),WD.map(w=>({wd:w,s1p:st.byWd[w].s1p,s2p:st.byWd[w].s2p})),['s1p','s2p'],[C.s1,C.s2],{h:180,xk:'wd',labels:['Смена 1','Смена 2']});}

