<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>СЦ Новочебоксарск — Аналитика</title>
<!-- Загрузка библиотеки XLSX через CDN (вместо огромного встроенного скрипта) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#0d1117;color:#e6edf3;font-family:Inter,system-ui,sans-serif;font-size:13px}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-thumb{background:#30363d;border-radius:3px}
a{color:inherit;text-decoration:none}

/* HEADER */
.hdr{background:#161b22;border-bottom:1px solid #21262d;padding:12px 16px 0;position:sticky;top:0;z-index:200}
.hdr-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px}
.title{font-size:16px;font-weight:700}
.sub{font-size:9px;color:#7d8590}
.controls{display:flex;gap:5px;align-items:center;flex-wrap:wrap;margin-left:auto}
.ctrl{background:#1c2128;border:1px solid #21262d;color:#e6edf3;border-radius:6px;padding:4px 7px;font-size:11px;cursor:pointer;font-family:inherit;outline:none}
.ctrl:focus{border-color:#6366f1}
select.ctrl option{background:#1c2128}
.btn{background:#1a2333;border:1px solid #21262d;color:#3b82f6;border-radius:6px;padding:4px 10px;font-size:11px;cursor:pointer;font-weight:600;font-family:inherit;white-space:nowrap}
.btn:hover{background:#1d3a6e}
.btn-red{color:#ef4444;background:#2d1a1a;border-color:#ef444430}
.tab-bar{display:flex;overflow-x:auto;gap:0;border-top:1px solid #21262d;margin-top:8px}
.tab{background:none;border:none;border-bottom:2px solid transparent;color:#7d8590;padding:7px 12px;font-size:11px;font-weight:500;cursor:pointer;white-space:nowrap;font-family:inherit;transition:color .1s}
.tab.on{color:#e6edf3;border-bottom-color:#6366f1}
.tab:hover{color:#c9d1d9}

/* LAYOUT */
.page{padding:14px}
.kpi-row{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:10px}
.kpi{background:#161b22;border:1px solid #21262d;border-radius:10px;padding:11px 14px;flex:1;min-width:110px}
.kpi-lbl{font-size:8px;color:#7d8590;text-transform:uppercase;letter-spacing:.8px;margin-bottom:3px}
.kpi-val{font-size:20px;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.1}
.kpi-sub{font-size:9px;color:#7d8590;margin-top:2px}
.card{background:#161b22;border:1px solid #21262d;border-radius:12px;padding:13px 14px 8px;margin-bottom:10px}
.card-t{font-size:9px;font-weight:600;color:#7d8590;text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.g3{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px;margin-bottom:10px}

/* TABLE */
.tbl-wrap{border:1px solid #21262d;border-radius:10px;overflow:hidden}
.tbl-scroll{overflow:auto;max-height:55vh}
table{width:100%;border-collapse:collapse;font-size:11px}
th{padding:7px 9px;color:#7d8590;font-weight:600;font-size:9px;text-transform:uppercase;letter-spacing:.4px;background:#1c2128;position:sticky;top:0;z-index:1;white-space:nowrap}
td{padding:5px 9px;border-bottom:1px solid #21262d15}
tr.clickable{cursor:pointer}
tr.clickable:hover td{background:#1c2128}
tr.sel td{background:#0d1b2a!important}
.tr{text-align:right}

/* CARDS */
.dir-card,.wh-card,.wd-card{background:#161b22;border:1px solid #21262d;border-radius:12px;padding:13px}
.mini-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px;margin:7px 0}
.mini-box{background:#0d1117;border-radius:5px;padding:5px 7px}
.mini-lbl{font-size:7px;color:#7d8590;margin-bottom:1px;text-transform:uppercase;letter-spacing:.5px}
.mini-val{font-size:12px;font-weight:700}
.sr{display:flex;gap:4px;margin-top:6px}
.s1b{flex:1;background:#0d1b35;border:1px solid #3b82f620;border-radius:5px;padding:5px 7px}
.s2b{flex:1;background:#2a1800;border:1px solid #f59e0b20;border-radius:5px;padding:5px 7px}
.s1l{font-size:7px;color:#3b82f6;margin-bottom:2px;text-transform:uppercase}
.s2l{font-size:7px;color:#f59e0b;margin-bottom:2px;text-transform:uppercase}
.pbar{height:3px;background:#21262d;border-radius:2px;margin:5px 0 8px}
.pbar-fill{height:100%;border-radius:2px}

/* BADGES */
.bs1{display:inline-block;background:#1d3a6e;color:#3b82f6;border:1px solid #3b82f640;border-radius:3px;padding:1px 5px;font-size:9px;font-weight:700}
.bs2{display:inline-block;background:#3d2a00;color:#f59e0b;border:1px solid #f59e0b40;border-radius:3px;padding:1px 5px;font-size:9px;font-weight:700}
.bftl{color:#818cf8;font-weight:700;font-size:10px}
.bltl{color:#f472b6;font-weight:700;font-size:10px}

/* DRILL PANEL */
.drill{background:#0d1b2a;border:1px solid #3b82f640;border-radius:10px;padding:12px;margin-bottom:10px}
.drill-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.drill-title{font-weight:700;color:#3b82f6;font-size:12px}
.close-btn{background:none;border:none;color:#7d8590;font-size:16px;cursor:pointer;line-height:1;padding:0 4px}

/* LEGEND */
.legend{display:flex;gap:10px;flex-wrap:wrap;margin-top:5px;font-size:9px;color:#7d8590;padding:0 2px}
.leg-i{display:flex;align-items:center;gap:3px}
.leg-d{width:8px;height:8px;border-radius:2px;display:inline-block;flex-shrink:0}

/* UPLOAD */
.up-badge{display:inline-block;background:#0d2818;color:#10b981;padding:2px 6px;border-radius:3px;font-size:9px;border:1px solid #10b98130;margin:2px}
.err{color:#f87171;font-size:10px;padding:3px 0}

/* TOOLTIP */
.tt{position:fixed;background:#1c2128;border:1px solid #30363d;border-radius:8px;padding:9px 12px;font-size:11px;pointer-events:none;z-index:1000;display:none;max-width:260px;box-shadow:0 4px 20px #00000080}
.tt-title{color:#7d8590;font-weight:600;margin-bottom:5px;font-size:10px}
.tt-row{display:flex;justify-content:space-between;gap:16px;margin-bottom:2px}
.tt-lbl{color:#7d8590}
.tt-val{color:#e6edf3;font-weight:600}

/* SVG CHART */
.chart-wrap{position:relative;width:100%}
svg.chart{width:100%;overflow:visible;display:block}

input[type=date].ctrl{color-scheme:dark}
.hidden{display:none}
.sep{border-top:1px solid #21262d;margin:8px 0}

/* Util color classes */
.ut-hi{color:#10b981;font-weight:600}
.ut-md{color:#f59e0b;font-weight:600}
.ut-lo{color:#ef4444;font-weight:600}
.ut-na{color:#7d8590}
</style>
</head>
<body>
<div id="tt" class="tt"></div>

<div class="hdr">
  <div class="hdr-top">
    <div>
      <div class="sub">СЦ НОВОЧЕБОКСАРСК</div>
      <div class="title">Аналитика отгрузок</div>
    </div>
    <div class="controls">
      <input type="date" id="df" class="ctrl" title="Дата от">
      <span style="color:#7d8590;font-size:10px">—</span>
      <input type="date" id="dt" class="ctrl" title="Дата до">
      <button id="clearDt" class="btn btn-red hidden" onclick="clearDates()">✕</button>
      <select id="dirF" class="ctrl" onchange="applyF()">
        <option value="">Все направления</option>
        <option>Казань</option>
        <option>Нижний Новгород</option>
        <option>СПб</option>
        <option>Прочее</option>
      </select>
      <select id="whF" class="ctrl" onchange="applyF()">
        <option value="">Все склады</option>
        <option>ДО</option>
        <option>ХАБ КГТ</option>
        <option>ХАБ Возвраты</option>
      </select>
      <label class="btn" id="upBtn" title="Можно загружать несколько файлов">
        ＋ Файл(ы)
        <input type="file" id="fi" accept=".xlsx,.xls" multiple style="display:none" onchange="handleFiles(this)">
      </label>
    </div>
  </div>
  <div id="upInfo" style="padding-bottom:4px"></div>
  <div id="upErr" class="err"></div>
  <div class="tab-bar" id="tabs"></div>
</div>

<div class="page" id="pg"></div>

