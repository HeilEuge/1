let ttTimer=null;
function showTT(e,html){
  const el=document.getElementById('tt');
  el.innerHTML=html;el.style.display='block';
  moveTT(e);
}
function moveTT(e){
  const el=document.getElementById('tt');
  if(el.style.display==='none')return;
  let x=e.clientX+14,y=e.clientY-10;
  const w=el.offsetWidth,h=el.offsetHeight;
  if(x+w>window.innerWidth-8)x=e.clientX-w-10;
  if(y+h>window.innerHeight-8)y=e.clientY-h-10;
  el.style.left=x+'px';el.style.top=y+'px';
}
function hideTT(){document.getElementById('tt').style.display='none';}
document.addEventListener('mousemove',moveTT);

function ttHtml(title,...rows){
  return`<div class="tt-title">${esc(title)}</div>${rows.map(([l,v,c])=>`<div class="tt-row"><span class="tt-lbl">${esc(l)}</span><span class="tt-val" style="${c?'color:'+c:''}">${esc(String(v))}</span></div>`).join('')}`;
}

function drawBar(container,data,keys,colors,opts={}){
  const W=800,H=opts.h||180,ML=opts.ml||42,MB=28,MT=8,MR=8;
  const cW=W-ML-MR,cH=H-MB-MT;
  const n=data.length;
  if(!n){container.innerHTML=`<svg viewBox="0 0 ${W} ${H}" class="chart"></svg>`;return;}
  const stacked=opts.stacked!==false;
  const maxV=stacked?Math.max(...data.map(d=>keys.reduce((a,k)=>a+(d[k]||0),0))):Math.max(1,...data.flatMap(d=>keys.map(k=>d[k]||0)));
  if(!maxV){container.innerHTML=`<svg viewBox="0 0 ${W} ${H}" class="chart"></svg>`;return;}
  const bW=Math.max(2,(cW/n)*0.72),gap=(cW/n)*0.14;
  const yS=v=>MT+cH-(v/maxV)*cH;
  const xS=i=>ML+i*(cW/n)+gap;
  function yTk(v){return v>=1e6?(v/1e6).toFixed(1)+'М':v>=1e3?(v/1e3).toFixed(0)+'к':v>=100?Math.round(v):v;}

  let g='',yl='',bars='',xl='';
  for(let i=0;i<=4;i++){const v=Math.round(maxV*i/4);const y=yS(v);g+=`<line x1="${ML}" y1="${y}" x2="${W-MR}" y2="${y}" stroke="#21262d" stroke-dasharray="3,3"/>`;yl+=`<text x="${ML-3}" y="${y+3.5}" fill="#7d8590" font-size="9" text-anchor="end">${yTk(v)}</text>`;}

  const skip=Math.max(1,Math.ceil(n/22));
  data.forEach((d,i)=>{
    let stack=0;
    const ttRows=keys.map((k,ki)=>([opts.labels?.[ki]||k,fmtN(d[k]||0),colors[ki]]));
    const ttStr=ttHtml(d[opts.xk||'date']||String(i),...ttRows);
    const x=xS(i);
    keys.forEach((k,ki)=>{
      const v=d[k]||0;const bH=(v/maxV)*cH;const y=yS(stack+v);
      bars+=`<rect x="${x}" y="${y}" width="${bW}" height="${bH}" fill="${colors[ki]}" rx="${ki===keys.length-1?2:0}" data-tt="${esc(ttStr)}" class="bar-rect"/>`;
      stack+=v;
    });
    if(i%skip===0){const lbl=String(d[opts.xk||'date']||i);const sl=lbl.length>5?lbl.slice(0,5):lbl;xl+=`<text x="${x+bW/2}" y="${H-MB+13}" fill="#7d8590" font-size="8" text-anchor="middle">${esc(sl)}</text>`;}
  });

  const svg=`<svg viewBox="0 0 ${W} ${H}" class="chart">${g}${yl}${bars}${xl}</svg>`;
  container.innerHTML=svg;
  container.querySelectorAll('.bar-rect').forEach(el=>{
    el.addEventListener('mouseenter',e=>showTT(e,el.dataset.tt));
    el.addEventListener('mouseleave',hideTT);
  });
}

function drawLine(container,data,keys,colors,opts={}){
  const W=800,H=opts.h||160,ML=opts.ml||42,MB=28,MT=8,MR=8;
  const cW=W-ML-MR,cH=H-MB-MT;
  const n=data.length;
  if(!n){container.innerHTML=`<svg viewBox="0 0 ${W} ${H}" class="chart"></svg>`;return;}
  const vals=data.flatMap(d=>keys.map(k=>d[k]).filter(v=>v!=null));
  const maxV=opts.max||Math.max(1,...vals);
  const minV=opts.min||0;
  const xS=i=>ML+i*(cW/Math.max(1,n-1));
  const yS=v=>MT+cH-((v-minV)/(maxV-minV||1))*cH;
  function yTk(v){return v>=1e3?(v/1e3).toFixed(0)+'к':Math.round(v);}

  let g='',yl='',lines='',dots='',xl='';
  for(let i=0;i<=4;i++){const v=minV+Math.round((maxV-minV)*i/4);const y=yS(v);g+=`<line x1="${ML}" y1="${y}" x2="${W-MR}" y2="${y}" stroke="#21262d" stroke-dasharray="3,3"/>`;yl+=`<text x="${ML-3}" y="${y+3.5}" fill="#7d8590" font-size="9" text-anchor="end">${yTk(v)}</text>`;}

  const skip=Math.max(1,Math.ceil(n/18));
  keys.forEach((k,ki)=>{
    const pts=[];
    data.forEach((d,i)=>{if(d[k]!=null)pts.push(`${xS(i)},${yS(d[k]||0)}`);});
    if(pts.length>1)lines+=`<polyline points="${pts.join(' ')}" fill="none" stroke="${colors[ki]}" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/>`;
    data.forEach((d,i)=>{
      if(d[k]==null)return;
      const ttRows=keys.map((k2,ki2)=>([opts.labels?.[ki2]||k2,d[k2]!=null?fmtN(d[k2]):'—',colors[ki2]]));
      const ttStr=ttHtml(d[opts.xk||'date']||String(i),...ttRows);
      dots+=`<circle cx="${xS(i)}" cy="${yS(d[k]||0)}" r="3.5" fill="${colors[ki]}" stroke="${colors[ki]}22" stroke-width="4" class="dot-c" data-tt="${esc(ttStr)}" style="cursor:default"/>`;
    });
  });
  data.forEach((d,i)=>{if(i%skip===0){const lbl=String(d[opts.xk||'date']||i);const sl=lbl.length>5?lbl.slice(0,5):lbl;xl+=`<text x="${xS(i)}" y="${H-MB+13}" fill="#7d8590" font-size="8" text-anchor="middle">${esc(sl)}</text>`;}});

  container.innerHTML=`<svg viewBox="0 0 ${W} ${H}" class="chart">${g}${yl}${lines}${dots}${xl}</svg>`;
  container.querySelectorAll('.dot-c').forEach(el=>{
    el.addEventListener('mouseenter',e=>showTT(e,el.dataset.tt));
    el.addEventListener('mouseleave',hideTT);
  });
}

