function renderDirections(st){
  const{byDir,totals}=st;
  const DC={Казань:C.kzn,'Нижний Новгород':C.nn,СПб:C.spb,Прочее:C.mut};
  let cards=Object.entries(byDir).map(([dir,v])=>{
    const col=DC[dir]||C.mut;
    const pct=Math.round(v.p/(totals.p||1)*100);
