function stats(recs){
  const byDS={},byWd={},byH={},byDir={},byWh={},byDr={};
  WD.forEach(w=>{byWd[w]={r:0,p:0,o:0,s1r:0,s1p:0,s1o:0,s2r:0,s2p:0,s2o:0,un:[],ub:[]};});
  for(let h=0;h<24;h++)byH[h]={r:0,p:0,o:0,un:[],ub:[]};
  ['Казань','Нижний Новгород','СПб','Прочее'].forEach(d=>{byDir[d]={r:0,p:0,o:0,ftl:0,ltl:0,s1r:0,s1p:0,s2r:0,s2p:0,un:[],ub:[]};});
  ['ДО','ХАБ КГТ','ХАБ Возвраты'].forEach(w=>{byWh[w]={r:0,p:0,o:0,s1r:0,s1p:0,s2r:0,s2p:0,un:[],ub:[]};});

  let totR=0,totP=0,totO=0,s1r=0,s2r=0,s1p=0,s2p=0,s1o=0,s2o=0;
  const unAll=[],ubAll=[];

  for(const rec of recs){
    const[,d,w,s,h,p,o]=rec;
    const un=rec[F.un],ub=rec[F.ub];
    totR++;totP+=p;totO+=o;
    if(s===1){s1r++;s1p+=p;s1o+=o;}
    if(s===2){s2r++;s2p+=p;s2o+=o;}
    if(un!=null)unAll.push(un);
    if(ub!=null)ubAll.push(ub);

    const k=d+'|'+s;
    if(!byDS[k])byDS[k]={date:d,wd:w,shift:s,r:0,p:0,o:0,un:[],ub:[]};
    byDS[k].r++;byDS[k].p+=p;byDS[k].o+=o;
    if(un!=null)byDS[k].un.push(un);
    if(ub!=null)byDS[k].ub.push(ub);

    if(w&&byWd[w]){byWd[w].r++;byWd[w].p+=p;byWd[w].o+=o;if(un!=null)byWd[w].un.push(un);if(ub!=null)byWd[w].ub.push(ub);if(s===1){byWd[w].s1r++;byWd[w].s1p+=p;byWd[w].s1o+=o;}if(s===2){byWd[w].s2r++;byWd[w].s2p+=p;byWd[w].s2o+=o;}}

    if(h!=null&&byH[h]){byH[h].r++;byH[h].p+=p;byH[h].o+=o;if(un!=null)byH[h].un.push(un);if(ub!=null)byH[h].ub.push(ub);}

    getDirs(rec).forEach(d2=>{if(byDir[d2]){byDir[d2].r++;byDir[d2].p+=p;byDir[d2].o+=o;if(un!=null)byDir[d2].un.push(un);if(ub!=null)byDir[d2].ub.push(ub);if(s===1){byDir[d2].s1r++;byDir[d2].s1p+=p;}if(s===2){byDir[d2].s2r++;byDir[d2].s2p+=p;}if(rec[F.tp]==='FTL')byDir[d2].ftl++;if(rec[F.tp]==='LTL')byDir[d2].ltl++;}});
    getWhs(rec).forEach(w2=>{if(byWh[w2]){byWh[w2].r++;byWh[w2].p+=p;byWh[w2].o+=o;if(un!=null)byWh[w2].un.push(un);if(ub!=null)byWh[w2].ub.push(ub);if(s===1){byWh[w2].s1r++;byWh[w2].s1p+=p;}if(s===2){byWh[w2].s2r++;byWh[w2].s2p+=p;}}});
    getDrs(rec).forEach(dr=>{if(!dr)return;if(!byDr[dr])byDr[dr]={r:0,p:0,o:0,un:[],ub:[],dirs:new Set(),tps:new Set(),tcs:new Set()};byDr[dr].r++;byDr[dr].p+=p;byDr[dr].o+=o;if(un!=null)byDr[dr].un.push(un);if(ub!=null)byDr[dr].ub.push(ub);getDirs(rec).forEach(x=>byDr[dr].dirs.add(x));if(rec[F.tp])byDr[dr].tps.add(rec[F.tp]);getTCs(rec).forEach(x=>byDr[dr].tcs.add(x));});
  }

  const dateMap={};
  for(const v of Object.values(byDS)){
    const dt=v.date;
    if(!dateMap[dt])dateMap[dt]={date:dt,wd:v.wd,r:0,p:0,o:0,s1r:0,s1p:0,s2r:0,s2p:0,s1o:0,s2o:0,un:[],ub:[]};
    const dm=dateMap[dt];
    dm.r+=v.r;dm.p+=v.p;dm.o+=v.o;dm.un.push(...v.un);dm.ub.push(...v.ub);
    if(v.shift===1){dm.s1r+=v.r;dm.s1p+=v.p;dm.s1o+=v.o;}
    if(v.shift===2){dm.s2r+=v.r;dm.s2p+=v.p;dm.s2o+=v.o;}
  }
  const tl=Object.values(dateMap).sort((a,b)=>dkey(a.date)<dkey(b.date)?-1:1).map(d=>({...d,un:avg(d.un),ub:avg(d.ub)}));
  const dateRows=Object.values(byDS).sort((a,b)=>{const ka=dkey(a.date),kb=dkey(b.date);return ka!==kb?ka<kb?-1:1:a.shift-b.shift;}).map(d=>({...d,un:avg(d.un),ub:avg(d.ub)}));
  const hArr=Array.from({length:24},(_,h)=>({h:String(h).padStart(2,'0')+':00',...byH[h],un:avg(byH[h].un),ub:avg(byH[h].ub)}));
  const topDr=Object.entries(byDr).map(([k,v])=>({name:k,...v,un:avg(v.un),ub:avg(v.ub),dirs:[...v.dirs],tps:[...v.tps],tcs:[...v.tcs]})).sort((a,b)=>b.r-a.r).slice(0,30);
  const totals={r:totR,p:totP,o:totO,s1r,s2r,s1p,s2p,s1o,s2o,cancelled:totalCancelled(),un:avg(unAll),ub:avg(ubAll)};
  return{tl,dateRows,byWd,hArr,byDir,byWh,topDr,totals};
}

