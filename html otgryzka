    function gDir(dests){const ds=dests.join(' ').toUpperCase();const d=[];if(/КАЗАНЬ|ЗЕЛЕНОДОЛЬСК|ЙОШКАР/.test(ds))d.push('Казань');if(/НИЖНИЙ/.test(ds))d.push('Нижний Новгород');if(/СПБ|БУГРЫ|ВОЛХОНСКОЕ/.test(ds))d.push('СПб');if(!d.length)d.push('Прочее');return d;}
    function pDate(v){if(typeof v==='number'){const d=XLSX.SSF.parse_date_code(v);return`${String(d.d).padStart(2,'0')}.${String(d.m).padStart(2,'0')}.${d.y}`;}return String(v||'').split(' ')[0];}
