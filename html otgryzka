      const drs=new Set(grp.map(r=>cleanDr(r[idx['Водитель']]||'')).filter(Boolean));
      let tn='',mk='',cap=0;
      for(const r of grp){if(r[idx['Номер ТС']]){tn=String(r[idx['Номер ТС']]).split('/')[0];break;}}
      for(const r of grp){if(r[idx['Марка ТС']]){mk=String(r[idx['Марка ТС']]).slice(0,40);break;}}
      for(const r of grp){if(r[idx['Ёмкость ТС']]){cap=+r[idx['Ёмкость ТС']]||0;break;}}
      const uns=grp.map(r=>pUtil(r[idx['Утилизация (нетто)']])).filter(x=>x!=null);
      const ubs=grp.map(r=>pUtil(r[idx['Утилизация (брутто)']])).filter(x=>x!=null);
      result.push([reid,ds,wd,sh,hr,tP,tO,dirs.join(','),[...whSet].join(','),whb,[...tps].sort().join('/'),[...tcs].join(','),[...drs].join(','),tn,mk,cap,uns.length?Math.round(uns.reduce((a,b)=>a+b)/uns.length):null,ubs.length?Math.round(ubs.reduce((a,b)=>a+b)/ubs.length):null]);
    }
    return{records:result,cancelled};
  }catch(e){return{error:e.message};}
}

async function handleFiles(input){
  const files=[...input.files];if(!files.length)return;
  document.getElementById('upErr').textContent='';
  document.getElementById('upBtn').textContent='⏳ Загрузка...';
  for(const file of files){
    try{
      const buf=await file.arrayBuffer();
      const res=parseXLSXFile(buf);
      if(res.error){document.getElementById('upErr').textContent+=file.name+': '+res.error+' ';}
      else if(!res.records.length){document.getElementById('upErr').textContent+=file.name+': нет рейсов «Убыла» ';}
      else{
        extraRecs.push(...res.records);
        extraCancelled+=res.cancelled;
        loadedFiles.push({name:file.name,count:res.records.length});
        const info=document.getElementById('upInfo');
        info.innerHTML=loadedFiles.map(f=>`<span class="up-badge">📄 ${esc(f.name)} (${f.count} рейсов)</span>`).join('');
      }
    }catch(e){document.getElementById('upErr').textContent+=file.name+': '+e.message+' ';}
  }
  document.getElementById('upBtn').textContent='＋ Файл(ы)';
  input.value='';
  applyF();
}

