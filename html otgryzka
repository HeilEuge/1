    return`<div class="dir-card" style="border-color:${col}40">
      <div style="display:flex;justify-content:space-between;margin-bottom:4px">
        <div style="font-size:13px;font-weight:700;color:${col}">${esc(dir)}</div>
        <div style="text-align:right;font-size:10px">${uts(v.un)} <span style="color:#7d8590">/ ${utS(v.ub)}</span></div>
      </div>
      ${pb(pct,col)}
      <div class="mini-grid">
        <div class="mini-box"><div class="mini-lbl">Рейсов</div><div class="mini-val">${fmtN(v.r)}</div></div>
        <div class="mini-box"><div class="mini-lbl">Поддонов</div><div class="mini-val">${fmtN(v.p)}</div></div>
        <div class="mini-box"><div class="mini-lbl">Отправлений</div><div class="mini-val">${fmt(v.o)}</div></div>
        <div class="mini-box"><div class="mini-lbl">Ср. пд/рейс</div><div class="mini-val">${v.r?Math.round(v.p/v.r):0}</div></div>
      </div>
      <div style="margin:6px 0 3px">
        <div style="font-size:8px;color:#7d8590;margin-bottom:3px;text-transform:uppercase;letter-spacing:.5px">Смена</div>
        <div style="display:flex;gap:4px">
          <div class="s1b" style="flex:1"><div class="s1l">Смена 1</div><div style="font-size:10px;font-weight:600">${v.s1r} р · ${fmtN(v.s1p)} пд</div></div>
          <div class="s2b" style="flex:1"><div class="s2l">Смена 2</div><div style="font-size:10px;font-weight:600">${v.s2r} р · ${fmtN(v.s2p)} пд</div></div>
        </div>
      </div>
      <div style="margin-top:6px">
        <div style="font-size:8px;color:#7d8590;margin-bottom:3px;text-transform:uppercase;letter-spacing:.5px">Тип заявки</div>
        <div style="display:flex;height:5px;border-radius:3px;overflow:hidden;gap:1px">
          <div style="width:${Math.round(v.ftl/tt*100)}%;background:${C.ftl}"></div>
          <div style="width:${Math.round(v.ltl/tt*100)}%;background:${C.ltl}"></div>
        </div>
        <div style="display:flex;gap:8px;margin-top:3px">
          <span style="font-size:9px;color:${C.ftl}">FTL: ${v.ftl}</span>
          <span style="font-size:9px;color:${C.ltl}">LTL: ${v.ltl}</span>
