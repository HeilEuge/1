  drawBar(document.getElementById('c0c'),tl,['s1p','s2p'],[C.s1,C.s2],{h:200,labels:['Смена 1','Смена 2']});
  drawLine(document.getElementById('c1c'),tl.filter(d=>d.un!=null||d.ub!=null),['un','ub'],[C.tot,C.s2],{h:150,max:100,min:0,labels:['Нетто %','Брутто %']});
  drawBar(document.getElementById('c2c'),tl,['s1o','s2o'],[C.s1,C.s2],{h:150,labels:['С1 отпр','С2 отпр']});
}

function clickDate(date){
  selDate=selDate===date?null:date;
  // Highlight row
  document.querySelectorAll('#dateTbl tr').forEach(r=>{r.classList.toggle('sel',r.dataset.date===selDate);});
  if(!selDate){document.getElementById('drillTitle').textContent='← Выбери дату';document.getElementById('drillBody').innerHTML='<div style="color:#7d8590;padding:20px 0;text-align:center">Нажми на строку слева</div>';return;}
  const recs=drillRecs(filtered,selDate,null);
  const dayRec=recs[0];
  document.getElementById('drillTitle').innerHTML=`${esc(selDate)} (${esc(dayRec?.[F.w]||'')}) · ${recs.length} рейсов
    <span style="margin-left:8px">
      <button class="btn" style="font-size:9px;padding:2px 7px" onclick="selShift=selShift===1?null:1;mountDrill()">С1</button>
      <button class="btn" style="font-size:9px;padding:2px 7px;margin-left:2px" onclick="selShift=selShift===2?null:2;mountDrill()">С2</button>
    </span>`;
  mountDrill();
}

function mountDrill(){
  if(!selDate)return;
  const recs=drillRecs(filtered,selDate,selShift);
  document.getElementById('drillBody').innerHTML=drillTable(recs);
}

