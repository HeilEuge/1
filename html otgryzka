  let html=`<div class="g3">${cards}</div>`;
  html+=`<div id="cdir0" class="card"><div class="card-t">Поддоны по направлениям (детально)</div><div id="cdir0c" class="chart-wrap"></div>${leg([C.kzn,'Казань'],[C.nn,'НН'],[C.spb,'СПб'],[C.mut,'Прочее'])}</div>`;
  html+=`<div id="cdir1" class="card"><div class="card-t">Казань vs Нижний Новгород — поддоны по датам</div><div id="cdir1c" class="chart-wrap"></div>${leg([C.kzn,'Казань'],[C.nn,'НН'])}</div>`;
  // Direction top trucks table
  html+=`<div class="card"><div class="card-t">Топ рейсов по направлениям</div><div id="dirTbl"></div></div>`;
  return html;
}
function mountDirections(st){
  const{byDir,tl}=st;
  const DC={Казань:C.kzn,'Нижний Новгород':C.nn,СПб:C.spb,Прочее:C.mut};
  const wdData=Object.entries(byDir).map(([k,v])=>({dir:k,s1p:v.s1p,s2p:v.s2p}));
  drawBar(document.getElementById('cdir0c'),wdData,['s1p','s2p'],[C.s1,C.s2],{h:200,xk:'dir',labels:['Смена 1','Смена 2']});
  const kznM={},nnM={};
  filtered.forEach(r=>{const ds=getDirs(r);if(ds.includes('Казань'))kznM[r[F.d]]=(kznM[r[F.d]]||0)+r[F.p];if(ds.includes('Нижний Новгород'))nnM[r[F.d]]=(nnM[r[F.d]]||0)+r[F.p];});
  const allD=[...new Set([...Object.keys(kznM),...Object.keys(nnM)])].sort((a,b)=>dkey(a)<dkey(b)?-1:1);
  drawLine(document.getElementById('cdir1c'),allD.map(d=>({date:d,kzn:kznM[d]||0,nn:nnM[d]||0})),['kzn','nn'],[C.kzn,C.nn],{h:180,labels:['Казань','Нижний Новгород']});

  // Table: top carriers per direction
  const perDir={};
  filtered.forEach(r=>{getDirs(r).forEach(dir=>{if(!perDir[dir])perDir[dir]=[];perDir[dir].push(r);});});
  let tblHtml='<div style="overflow-x:auto"><table><thead><tr><th>Направление</th><th>Рейсов</th><th class="tr">Пд</th><th class="tr">Нетто</th><th>Тип</th><th>Склады</th></tr></thead><tbody>';
  for(const[dir,recs]of Object.entries(perDir)){
    const col=DC[dir]||C.mut;
    const totP=recs.reduce((a,r)=>a+r[F.p],0);
    const uns=recs.map(r=>r[F.un]).filter(x=>x!=null);
    const whs=[...new Set(recs.flatMap(r=>getWhs(r)))].join(', ');
    const tps=[...new Set(recs.map(r=>r[F.tp]).filter(Boolean))].join('/');
    tblHtml+=`<tr><td style="color:${col};font-weight:600">${esc(dir)}</td><td>${recs.length}</td><td class="tr" style="font-weight:600">${fmtN(totP)}</td><td class="tr">${uts(avg(uns))}</td><td><span class="bftl">${esc(tps)}</span></td><td style="color:#7d8590;font-size:10px">${esc(whs)}</td></tr>`;
  }
  tblHtml+='</tbody></table></div>';
  document.getElementById('dirTbl').innerHTML=tblHtml;
}

function renderWarehouses(st){
  const{byWh,totals}=st;
  const WC={ДО:C.do,'ХАБ КГТ':C.kgt,'ХАБ Возвраты':C.ret};
  let cards=Object.entries(byWh).map(([wh,v])=>{
    const col=WC[wh]||C.mut;
    const pct=Math.round(v.p/(totals.p||1)*100);
    return`<div class="wh-card clickable" style="border-color:${col}40;border:1px solid ${col}40" onclick="clickWh('${esc(wh)}')">
      <div style="display:flex;justify-content:space-between;margin-bottom:4px">
        <div style="font-size:14px;font-weight:700;color:${col}">${esc(wh)}</div>
        <div style="text-align:right"><div style="font-size:9px;color:#7d8590">${pct}% пд</div><div style="font-size:10px">${uts(v.un)}</div></div>
      </div>
      ${pb(pct,col)}
      <div class="mini-grid">
        <div class="mini-box"><div class="mini-lbl">Рейсов</div><div class="mini-val">${fmtN(v.r)}</div></div>
        <div class="mini-box"><div class="mini-lbl">Поддонов</div><div class="mini-val">${fmtN(v.p)}</div></div>
        <div class="mini-box"><div class="mini-lbl">Отправлений</div><div class="mini-val">${fmt(v.o)}</div></div>
        <div class="mini-box"><div class="mini-lbl">Ср. пд/рейс</div><div class="mini-val">${v.r?Math.round(v.p/v.r):0}</div></div>
      </div>
      <div class="sr">
        <div class="s1b" style="flex:1"><div class="s1l">С1</div><div style="font-size:10px;font-weight:600">${v.s1r} р · ${fmtN(v.s1p)} пд</div></div>
        <div class="s2b" style="flex:1"><div class="s2l">С2</div><div style="font-size:10px;font-weight:600">${v.s2r} р · ${fmtN(v.s2p)} пд</div></div>
      </div>
      <div style="margin-top:6px;font-size:9px;color:${C.acc}">Нажми для детализации →</div>
    </div>`;
  }).join('');

  return`<div class="g3">${cards}</div>
  <div id="whDrill" class="hidden drill"></div>
  <div id="cwhbar" class="card"><div class="card-t">Поддоны по складу</div><div id="cwhbarc" class="chart-wrap"></div>${leg([C.s1,'С1'],[C.s2,'С2'])}</div>`;
}
function mountWarehouses(st){
  drawBar(document.getElementById('cwhbarc'),Object.entries(st.byWh).map(([k,v])=>({wh:k,s1p:v.s1p,s2p:v.s2p})),['s1p','s2p'],[C.s1,C.s2],{h:180,xk:'wh',labels:['Смена 1','Смена 2']});
}
function clickWh(wh){
  selWh=selWh===wh?null:wh;
  document.querySelectorAll('.wh-card').forEach(el=>{el.style.outline=el.querySelector('div>div').textContent.trim()===wh&&selWh?`2px solid ${C.acc}`:'none';});
  const panel=document.getElementById('whDrill');
  if(!selWh){panel.classList.add('hidden');return;}
  const recs=filtered.filter(r=>getWhs(r).includes(selWh));
  panel.classList.remove('hidden');
  panel.innerHTML=`<div class="drill-hdr">
    <div class="drill-title">📦 ${esc(selWh)} · ${recs.length} рейсов</div>
    <button class="close-btn" onclick="clickWh('${esc(selWh)}')">×</button>
  </div>${drillTable(recs.slice(0,100))}${recs.length>100?`<div style="color:#7d8590;padding:6px 0;font-size:10px">Показано 100 из ${recs.length}</div>`:''}`;
}

function renderDrivers(st){
  const{topDr}=st;
  let html=`<div class="card"><div class="card-t">Топ-30 водителей — нажми для детализации</div>
  <div class="tbl-scroll"><table>
    <thead><tr><th>#</th><th>Водитель</th><th class="tr">Рейсов</th><th class="tr">Пд</th><th class="tr">Нетто</th><th class="tr">Брутто</th><th>Направления</th><th>Типы</th><th>ТК</th></tr></thead>
    <tbody id="drTbl"></tbody></table></div></div>
  <div id="drDrill" class="hidden drill"></div>`;
  return html;
}
function mountDrivers(st){
  const{topDr}=st;
  const rows=topDr.map((d,i)=>`<tr class="clickable" onclick="clickDriver('${esc(d.name.replace(/'/g,"\'"))}')">
    <td style="color:#7d8590;font-size:9px">${i+1}</td>
    <td style="font-weight:500;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(d.name)}">${esc(d.name)}</td>
    <td class="tr" style="color:${C.s1};font-weight:600">${d.r}</td>
    <td class="tr">${fmtN(d.p)}</td>
    <td class="tr">${uts(d.un)}</td>
    <td class="tr">${uts(d.ub)}</td>
    <td style="color:${C.kzn};font-size:10px;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(d.dirs.join(', '))}</td>
    <td style="font-size:10px"><span class="${d.tps.includes('FTL')?'bftl':'bltl'}">${esc(d.tps.join('/'))}</span></td>
    <td style="color:#7d8590;font-size:10px;max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(d.tcs.join(', '))}</td>
  </tr>`).join('');
  const tbl=document.getElementById('drTbl');
  if(tbl)tbl.innerHTML=rows;
}
function clickDriver(name){
  selDr=selDr===name?null:name;
  const panel=document.getElementById('drDrill');
  if(!selDr){panel.classList.add('hidden');return;}
  const recs=filtered.filter(r=>getDrs(r).includes(selDr)).sort((a,b)=>dkey(a[F.d])<dkey(b[F.d])?-1:1);
  if(!recs.length){panel.classList.add('hidden');return;}
  const totP=recs.reduce((a,r)=>a+r[F.p],0);
  const uns=recs.map(r=>r[F.un]).filter(x=>x!=null);
  const ubs=recs.map(r=>r[F.ub]).filter(x=>x!=null);
  panel.classList.remove('hidden');
  panel.innerHTML=`<div class="drill-hdr">
    <div class="drill-title">🧑 ${esc(selDr)}</div>
    <button class="close-btn" onclick="selDr=null;document.getElementById('drDrill').classList.add('hidden')">×</button>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px">
    ${kpi('Рейсов',recs.length,'',C.s1)}
    ${kpi('Поддонов',fmtN(totP),'',C.tot)}
    ${kpi('Нетто',utS(avg(uns)),'',C.tot)}
    ${kpi('Брутто',utS(avg(ubs)),'',C.s2)}
  </div>
  ${drillTable(recs)}`;
}

// ═══════════════════════════════════════════════════════════════
//  RENDER ORCHESTRATOR
// ═══════════════════════════════════════════════════════════════
function render(){
  // Tabs
  document.getElementById('tabs').innerHTML=TABS.map((t,i)=>`<button class="tab ${i===curTab?'on':''}" onclick="curTab=${i};selDate=null;selShift=null;selWh=null;selDr=null;render()">${t}</button>`).join('');
  const st=stats(filtered);
  const pg=document.getElementById('pg');

  if(curTab===0){pg.innerHTML=renderSummary(st);mountSummary(st);}
  else if(curTab===1){pg.innerHTML=renderWeekdays(st);mountWeekdays(st);}
  else if(curTab===2){pg.innerHTML=renderHours(st);mountHours(st);}
  else if(curTab===3){pg.innerHTML=renderDirections(st);mountDirections(st);}
  else if(curTab===4){pg.innerHTML=renderWarehouses(st);mountWarehouses(st);}
  else if(curTab===5){pg.innerHTML=renderDrivers(st);mountDrivers(st);}
}

